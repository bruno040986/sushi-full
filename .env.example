# ─── Banco (Supabase Postgres) ────────────────────────────────────────────────
# DATABASE_URL: Transaction Pooler (porta 6543) — usado pela aplicação em runtime
# DIRECT_URL:   usado por `prisma migrate`
#
# ATENÇÃO no DIRECT_URL: o formato `db.<ref>.supabase.co:5432` responde SÓ em
# IPv6. Em ambientes sem IPv6 (a Vercel, por exemplo) use a Session Pooler,
# que é IPv4 — mesmo host do pooler, porta 5432.
#
# Se a senha tiver caractere especial (@, #, /, :), codifique em percent-encoding:
# `@` vira `%40`, senão o parser lê o host errado.
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─── Endereço público do site ─────────────────────────────────────────────────
# Alimenta o metadataBase (preview do link no WhatsApp), o sitemap e a
# assinatura da mensagem de pedido. Sem barra no final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Enquanto o site estiver num endereço provisório, deixe ausente ou "false":
# os buscadores são bloqueados para não competir com o domínio definitivo.
# NEXT_PUBLIC_ALLOW_INDEXING="true"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── Admin inicial (lido só pelo seed) ────────────────────────────────────────
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Vercel Blob (upload de fotos pelo painel) ────────────────────────────────
# Vem de `vercel env pull`. Em dev, aponte para um store separado.
BLOB_READ_WRITE_TOKEN=""
